generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum ProviderType {
  OWNER
  BROKER
  AGENT
  AGENCY
  DEVELOPER
}

enum PreferredLanguage {
  EN
  AM
}

enum ListingPurpose {
  FOR_SALE
  FOR_RENT
  LOOKING_TO_BUY
  LOOKING_TO_RENT
}

enum PropertyCategory {
  RESIDENTIAL_HOUSE
  CONDOMINIUM
  APARTMENT
  VILLA
  STUDIO
  COMMERCIAL_SPACE
  OFFICE
  SHOP
  WAREHOUSE
  BUILDING
  HOTEL
  RESIDENTIAL_LAND
  COMMERCIAL_LAND
  AGRICULTURAL_LAND
}

enum PropertyCondition {
  NEW
  EXCELLENT
  GOOD
  NEEDS_RENOVATION
  UNDER_CONSTRUCTION
}

enum PublicationStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model User {
  id                String               @id @default(uuid())
  telegramId        BigInt               @unique
  firstName         String
  lastName          String?
  username          String?
  phoneNumber       String?              @unique
  isPhoneVerified   Boolean              @default(false)
  role              UserRole             @default(USER)
  providerType      ProviderType         @default(OWNER)
  preferredLanguage PreferredLanguage    @default(EN)
  
  properties        PropertyListing[]
  payments          PaymentTransaction[]
  favorites         UserFavorite[]

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([telegramId])
  @@index([phoneNumber])
}

model PropertyListing {
  id                String            @id @default(uuid())
  titleEn           String
  titleAm           String
  descriptionEn     String            @db.Text
  descriptionAm     String            @db.Text
  category          PropertyCategory
  purpose           ListingPurpose
  priceETB          Decimal           @db.Decimal(14, 2)
  areaSqMeters      Decimal?          @db.Decimal(10, 2)
  bedrooms          Int?
  bathrooms         Int?
  floors            Int?
  condition         PropertyCondition?
  isFurnished       Boolean?          @default(false)
  amenities         String[]          @default([])

  region            String            // Ethiopian Region
  subCity           String?           // Addis Ababa Sub-city
  woreda            String?
  kebele            String?
  areaName          String            // Specific area / landmark
  latitude          Float?
  longitude         Float?

  publicationStatus PublicationStatus @default(DRAFT)
  listingFeeETB     Decimal           @db.Decimal(10, 2) @default(0.00)
  isFeePaid         Boolean           @default(false)
  viewsCount        Int               @default(0)

  providerId        String
  provider          User              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerType      ProviderType      // Role specifically for this listing (Owner, Broker, Agent, Agency, Developer)

  images            PropertyImage[]
  payments          PaymentTransaction[]
  favoritedBy       UserFavorite[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  publishedAt       DateTime?
  expiresAt         DateTime?

  // High-performance search composite indexes
  @@index([publicationStatus, category, purpose])
  @@index([publicationStatus, providerType])
  @@index([publicationStatus, subCity, region])
  @@index([publicationStatus, priceETB])
  @@index([providerId])
}

model UserFavorite {
  id         String          @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime        @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   PropertyListing @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model PropertyImage {
  id         String          @id @default(uuid())
  url        String
  publicId   String
  isMain     Boolean         @default(false)
  order      Int             @default(0)

  propertyId String
  property   PropertyListing @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime        @default(now())

  @@index([propertyId])
}

model PaymentTransaction {
  id          String          @id @default(uuid())
  amountETB   Decimal         @db.Decimal(10, 2)
  status      PaymentStatus   @default(PENDING)
  providerRef String?         @unique
  paymentMethod String?

  userId      String
  user        User            @relation(fields: [userId], references: [id])

  propertyId  String
  property    PropertyListing @relation(fields: [propertyId], references: [id])

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}