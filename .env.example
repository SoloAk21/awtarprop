# General
NODE_ENV=development
PORT=5000

# Client Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_TELEGRAM_BOT_USERNAME=AwtarPropBot

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBAPP_URL=http://localhost:5173
TELEGRAM_CHANNEL_USERNAME=@awtarprop

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/awtarprop_db?schema=public"

# AI Generator (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security
JWT_SECRET=awtarprop_dev_secret_key_change_in_prod
JWT_EXPIRES_IN=7d