{
  "name": "awtarprop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AwtarProp - Production-Ready Real Estate & Land Marketplace in Ethiopia",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "bot"
  ],
  "scripts": {
    "build:shared": "npm --prefix shared run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:bot": "npm --prefix bot run dev",
    "build:backend": "npm run build:shared && npm --prefix backend run build",
    "build:frontend": "npm run build:shared && npm --prefix frontend run build",
    "build:bot": "npm run build:shared && npm --prefix bot run build",
    "lint": "npm --prefix shared run lint && npm --prefix backend run lint && npm --prefix frontend run lint && npm --prefix bot run lint"
  },
  "keywords": [
    "real-estate",
    "ethiopia",
    "telegram-mini-app",
    "awtarprop"
  ],
  "author": "AwtarProp Team",
  "license": "ISC",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@awtarprop/shared": "^1.0.0",
    "@prisma/client": "^7.9.1",
    "acorn": "^8.18.0",
    "any-promise": "^1.3.0",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "commander": "^4.1.1",
    "compression": "^1.8.1",
    "confbox": "^0.1.8",
    "consola": "^3.4.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.27.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fdir": "^6.5.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "helmet": "^8.3.0",
    "joycon": "^3.1.1",
    "lilconfig": "^3.1.3",
    "lines-and-columns": "^1.2.4",
    "load-tsconfig": "^0.2.5",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "object-assign": "^4.1.1",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pirates": "^4.0.7",
    "pkg-types": "^1.3.1",
    "postcss-load-config": "^6.0.1",
    "readdirp": "^4.1.2",
    "resolve-from": "^5.0.0",
    "rollup": "^4.62.5",
    "shared": "^1.0.0",
    "source-map": "^0.7.6",
    "sucrase": "^3.35.1",
    "thenify": "^3.3.1",
    "thenify-all": "^1.6.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "ts-interface-checker": "^0.1.13",
    "tsup": "^8.5.1",
    "ufo": "^1.6.4",
    "undici-types": "^8.3.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoloAk21/awtarprop.git"
  },
  "bugs": {
    "url": "https://github.com/SoloAk21/awtarprop/issues"
  },
  "homepage": "https://github.com/SoloAk21/awtarprop#readme",
